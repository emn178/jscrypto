{
  "name": "@jscrypto/kdfs",
  "version": "0.11.0",
  "description": "KDF components for @jscrypto.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./argon2": {
      "types": "./dist/argon2.d.ts",
      "import": "./dist/argon2.mjs",
      "require": "./dist/argon2.cjs"
    },
    "./argon2/browser": "./dist/jscrypto-kdfs-argon2.iife.min.js",
    "./argon2/umd": "./dist/jscrypto-kdfs-argon2.umd.min.js",
    "./evpkdf": {
      "types": "./dist/evpkdf.d.ts",
      "import": "./dist/evpkdf.mjs",
      "require": "./dist/evpkdf.cjs"
    },
    "./evpkdf/browser": "./dist/jscrypto-kdfs-evpkdf.iife.min.js",
    "./evpkdf/umd": "./dist/jscrypto-kdfs-evpkdf.umd.min.js",
    "./hkdf": {
      "types": "./dist/hkdf.d.ts",
      "import": "./dist/hkdf.mjs",
      "require": "./dist/hkdf.cjs"
    },
    "./hkdf/browser": "./dist/jscrypto-kdfs-hkdf.iife.min.js",
    "./hkdf/umd": "./dist/jscrypto-kdfs-hkdf.umd.min.js",
    "./pbkdf2": {
      "types": "./dist/pbkdf2.d.ts",
      "import": "./dist/pbkdf2.mjs",
      "require": "./dist/pbkdf2.cjs"
    },
    "./pbkdf2/browser": "./dist/jscrypto-kdfs-pbkdf2.iife.min.js",
    "./pbkdf2/umd": "./dist/jscrypto-kdfs-pbkdf2.umd.min.js",
    "./scrypt": {
      "types": "./dist/scrypt.d.ts",
      "import": "./dist/scrypt.mjs",
      "require": "./dist/scrypt.cjs"
    },
    "./scrypt/browser": "./dist/jscrypto-kdfs-scrypt.iife.min.js",
    "./scrypt/umd": "./dist/jscrypto-kdfs-scrypt.umd.min.js",
    "./browser": "./dist/jscrypto-kdfs.iife.min.js",
    "./umd": "./dist/jscrypto-kdfs.umd.min.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@jscrypto/core": "0.11.0",
    "@noble/hashes": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emn178/jscrypto.git",
    "directory": "packages/kdfs"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "license": "MIT"
}
